# ---- Required ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=solocrm
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=*

# Required for encrypting API keys at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Secret used to sign session JWTs. Falls back to APP_ENCRYPTION_KEY if unset.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---- Optional: UI ----
# ISO 4217 currency code for money formatting (default USD). e.g. USD, EUR, INR, GBP
NEXT_PUBLIC_CURRENCY=USD
# Optional locale override for number/currency formatting (default: user's locale)
NEXT_PUBLIC_LOCALE=

# ---- Optional: Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Optional: WhatsApp (Meta Cloud API) ----
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
